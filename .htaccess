# Block direct web access to sensitive files
<FilesMatch "^\.env|contact_log\.txt|spam_log\.txt$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Compress text-based assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/javascript application/javascript text/html application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# LiteSpeed Cache (LSCache) — page-level cache for the LiteSpeed web server.
# Works even without the cPanel "LiteSpeed Web Cache Manager" plugin, since
# LSWS reads these directives directly from .htaccess.
<IfModule LiteSpeed>
    CacheLookup on

    # Cache GET pages publicly. The mod_headers rule below sends an explicit
    # short Cache-Control on every .php response, which LiteSpeed honors as
    # the page's TTL instead of falling back to the server-wide default.
    CacheEnable public /

    # Never cache the contact form handler or page — they must run fresh
    # on every request.
    <FilesMatch "^(process-contact|contact)\.php$">
        CacheLookup off
    </FilesMatch>
</IfModule>

# Keep HTML/PHP responses short-lived (5 minutes) instead of relying on the
# server's unbounded default cache policy, so pages revalidate frequently
# and don't risk serving stale or mismatched content.
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
</IfModule>
